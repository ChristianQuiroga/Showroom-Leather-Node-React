{
  "name": "backend",
  "version": "1.0.0",
  "description": "API REST para la gestión del showroom de artículos de cuero",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --watch src --watch .env --ext js,json,env src/server.js",
    "start": "node src/server.js",
    "create:admin": "node src/scripts/create-admin.js",
    "migrate:create": "node-pg-migrate create",
    "migrate:up": "node --env-file=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate up",
    "migrate:down": "node --env-file=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate down",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "keywords": [
    "nodejs",
    "express",
    "showroom",
    "leather",
    "api-rest"
  ],
  "author": "Christian Quiroga Enriquez",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "node-pg-migrate": "^9.0.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
