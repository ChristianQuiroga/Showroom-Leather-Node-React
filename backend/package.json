{
  "name": "backend",
  "version": "1.0.0",
  "description": "API REST para la gestión del showroom de artículos de cuero",
  "main": "src/server.js",
 "scripts": {
  "dev": "nodemon --watch src --watch .env --ext js,json,env src/server.js",
  "start": "node src/server.js",
  "migrate:create": "node-pg-migrate create",
  "migrate:up": "node --env-file=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate up",
  "migrate:down": "node --env-file=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate down",
  "test": "echo \"Tests pendientes\""
},
  "keywords": [
    "nodejs",
    "express",
    "showroom",
    "leather",
    "api-rest"
  ],
  "author": "Christian Quiroga Enriquez",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "node-pg-migrate": "^9.0.0",
    "nodemon": "^3.1.14"
  }
}
